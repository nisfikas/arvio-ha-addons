# Standalone agent for Home Assistant Container (NAS / docker compose).
# HAOS add-on still uses ./Dockerfile + bashio.
FROM python:3.12-alpine

# android-tools: adb, for installing the Arvio Panel app on wall panels (arvio docs/ADR/012).
RUN apk add --no-cache android-tools \
  && pip3 install --no-cache-dir websocket-client==1.8.0 pillow==11.1.0

WORKDIR /app
COPY agent.py occupancy.py panel_install.py guest_tv.py launcher.py ui.html panel.html tv.html lan-sign.js /app/
COPY panel-app /app/panel-app
ENV ARVIO_DATA_DIR=/data
EXPOSE 8099
# launcher.py runs the newest agent OTA staged in /data (Console → Target Agent), else this image's.
CMD ["python3", "/app/launcher.py"]
